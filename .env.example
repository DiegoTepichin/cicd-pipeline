# Copy to .env and adjust: cp .env.example .env
# .env is git-ignored — never commit real secrets.

# ─── App ───────────────────────────────────────
APP_NAME="CI/CD Pipeline"
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ─── Local dev server (python -m app.main) ─────
HOST=127.0.0.1
PORT=5000

# ─── Production (Gunicorn inside the runner image)
GUNICORN_CMD_ARGS="--workers 2 --threads 4 --timeout 30 --access-logfile -"
